# Copie para ".env" e preencha. Rode com:  node --env-file=.env --no-warnings server.js

# Endereço público do site (com https:// quando estiver no ar)
URL_BASE=http://localhost:3000
PORT=3000
NOME_PLATAFORMA=Rifa Clara

# Quanto a plataforma fica de cada rifa, em % do arrecadado. O organizador recebe o resto.
TAXA_PLATAFORMA=10

# Quem se cadastrar com este e-mail vira o administrador (vê tudo e paga os repasses).
ADMIN_EMAIL=voce@exemplo.com

# Pagamento: "simulado" (teste, sem dinheiro) ou "mercadopago" (Pix de verdade)
PAGAMENTO=simulado
MP_ACCESS_TOKEN=

# Minutos que os números ficam guardados esperando o Pix (o Mercado Pago pede 30 ou mais)
RESERVA_MINUTOS=30
